{
	"name": "@emems/n8n-nodes-bitsnap",
	"version": "1.0.8",
	"description": "n8n community nodes for Bitsnap (bitsnap.pl) public API",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"bitsnap"
	],
	"license": "MIT",
	"homepage": "https://bitsnap.pl",
	"author": {
		"name": "Piotr Michalik",
		"email": "michalik.piotr@icloud.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/emmems/n8n-bitsnap-nodes.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/BitsnapApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Bitsnap/Bitsnap.node.js",
			"dist/nodes/BitsnapTrigger/BitsnapTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "1.0.1",
		"@types/node": "^24.10.1",
		"eslint": "9.32.0",
		"n8n-workflow": "3.0.1",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2",
		"vite": "^7.3.7",
		"vitest": "^5.0.5"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
